{
  "name": "padel-band",
  "version": "0.7.0",
  "private": true,
  "description": "Padel score counter for the Xiaomi Smart Band 10 (Vela JS quick app)",
  "scripts": {
    "build": "aiot build --enable-jsc",
    "test": "node --test test/padel.test.mjs test/log.test.mjs test/i18n.test.mjs",
    "test:ui": "aiot build && node --test test/ui.test.mjs",
    "test:all": "npm test && npm run test:ui",
    "sim": "aiot build && node tools/serve.mjs",
    "emu:setup": "aiot initEmulatorEnv && node tools/emu-setup.mjs",
    "emu": "aiot start",
    "emu:install": "npm run build && node tools/emu.mjs install"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.10",
    "aiot-toolkit": "2.0.5",
    "playwright": "^1.65.1"
  }
}
