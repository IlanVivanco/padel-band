<template>
  <div class="page">
    <!-- Score view. Top half is them (orange), bottom half is us (blue); the
         same colours run through the scoreboard, so no labels are needed.
         Tap or swipe right on a half: point for that side. Swipe left: take
         one away. Long-press: menu. -->
    <div class="score" if="{{ !menu }}">
      <!-- Each half is a fixed three-slot stack (label / points / label), so
           the points stay centred whether or not a label is showing. The
           label sits on the outer side: above for them, below for us. -->
      <div id="half-them" class="half {{ themBg }}"
           ontouchstart="startThem" ontouchmove="move" ontouchend="endThem" ontouchcancel="cancel" onlongpress="openMenu">
        <text id="label-them" class="label label-them">{{ themLabel }}</text>
        <text id="pts-them" class="points {{ themPtsCls }}" if="{{ !themLost }}">{{ themPts }}</text>
        <div id="lost-them" class="lost" if="{{ themLost }}"><div class="lost-bar"></div></div>
        <text class="label"></text>
      </div>

      <!-- Scoreboard: one column per set, their games over ours. The set in
           play sits on a grey tile. In a finished set the winner's number is
           bold and underlined and the loser's is dimmed. Each column is
           slot / them / slot / us / slot, so both numbers sit symmetrically
           about the middle; a winner's bar goes in the slot below its number. -->
      <div class="board">
        <div class="col {{ colCur[0] ? 'col-cur' : '' }}" if="{{ colOn[0] }}">
          <div class="bar-slot"></div>
          <text id="c0-them" class="num {{ colThemCls[0] }}">{{ colThem[0] }}</text>
          <div class="bar-slot"><div class="bar {{ colThemBar[0] }}"></div></div>
          <text id="c0-us" class="num {{ colUsCls[0] }}">{{ colUs[0] }}</text>
          <div class="bar-slot"><div class="bar {{ colUsBar[0] }}"></div></div>
        </div>
        <div class="col {{ colCur[1] ? 'col-cur' : '' }}" if="{{ colOn[1] }}">
          <div class="bar-slot"></div>
          <text id="c1-them" class="num {{ colThemCls[1] }}">{{ colThem[1] }}</text>
          <div class="bar-slot"><div class="bar {{ colThemBar[1] }}"></div></div>
          <text id="c1-us" class="num {{ colUsCls[1] }}">{{ colUs[1] }}</text>
          <div class="bar-slot"><div class="bar {{ colUsBar[1] }}"></div></div>
        </div>
        <div class="col {{ colCur[2] ? 'col-cur' : '' }}" if="{{ colOn[2] }}">
          <div class="bar-slot"></div>
          <text id="c2-them" class="num {{ colThemCls[2] }}">{{ colThem[2] }}</text>
          <div class="bar-slot"><div class="bar {{ colThemBar[2] }}"></div></div>
          <text id="c2-us" class="num {{ colUsCls[2] }}">{{ colUs[2] }}</text>
          <div class="bar-slot"><div class="bar {{ colUsBar[2] }}"></div></div>
        </div>
      </div>

      <div id="half-us" class="half {{ usBg }}"
           ontouchstart="startUs" ontouchmove="move" ontouchend="endUs" ontouchcancel="cancel" onlongpress="openMenu">
        <text class="label"></text>
        <text id="pts-us" class="points {{ usPtsCls }}" if="{{ !usLost }}">{{ usPts }}</text>
        <div id="lost-us" class="lost" if="{{ usLost }}"><div class="lost-bar"></div></div>
        <text id="label-us" class="label label-us">{{ usLabel }}</text>
      </div>

      <!-- Status pill (TIE-BREAK / PUNTO DE ORO), centred on the edge between
           the scoreboard and our half, so nothing else moves when it shows. -->
      <div class="pill-wrap" if="{{ pill }}">
        <div class="pill"><text id="pill" class="pill-text">{{ pill }}</text></div>
      </div>
    </div>

    <!-- Menu: reset, golden point, keep screen on, exit, back. -->
    <div class="menu" if="{{ menu }}">
      <text class="menu-title">Menú</text>
      <div id="m-reset" class="btn btn-danger" onclick="resetMatch"><text class="btn-label">Reiniciar partido</text></div>
      <div id="m-golden" class="btn" onclick="toggleGolden"><text class="btn-label">Punto de oro: {{ golden ? 'Sí' : 'No' }}</text></div>
      <div id="m-screen" class="btn" onclick="toggleScreen"><text class="btn-label">Pantalla fija: {{ keepOn ? 'Sí' : 'No' }}</text></div>
      <div id="m-exit" class="btn" onclick="exitApp"><text class="btn-label">Salir</text></div>
      <div id="m-back" class="btn btn-primary" onclick="closeMenu"><text class="btn-label btn-label-dark">Volver</text></div>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import app from '@system.app'
import {
  US, THEM, newMatch, score, addPoint, removePoint, setGolden, pointLabels,
  serialize, deserialize
} from '../../common/padel'

var STORE_KEY = 'padel-band-state'
var PREFS_KEY = 'padel-band-prefs'
var MIN_DX = 30 // px of horizontal travel for a swipe
var TAP_SLOP = 12 // px a tap may wander
var TAP_MS = 450 // longer than this is not a tap (long-press opens the menu)
var FLASH_MS = 220

// Held outside `private` so the framework doesn't make them reactive.
var match = newMatch(false)
var touch = null // { x, y, lastX, lastY, t } while a finger is down
var flashTimer = null
var flash = '' // 'u+', 't-' ... while a half is flashing

function pointOf(evt, list) {
  var l = evt && evt[list]
  if (l && l.length) return l[0]
  return null
}

export default {
  private: {
    menu: false,
    golden: false,
    keepOn: true,
    themPts: '0',
    usPts: '0',
    themPtsCls: 'pts-them',
    usPtsCls: 'pts-us',
    themLabel: '',
    usLabel: '',
    themLost: false,
    usLost: false,
    themBg: '',
    usBg: '',
    colOn: [true, false, false],
    colCur: [true, false, false],
    colThem: ['0', '', ''],
    colUs: ['0', '', ''],
    colThemCls: ['num-them', '', ''],
    colUsCls: ['num-us', '', ''],
    colThemBar: ['', '', ''],
    colUsBar: ['', '', ''],
    pill: ''
  },

  onInit() {
    var page = this
    match = newMatch(false)
    this.render()
    try {
      storage.get({
        key: STORE_KEY,
        default: '',
        success: function (data) {
          match = deserialize(data)
          page.render()
        }
      })
      storage.get({
        key: PREFS_KEY,
        default: '',
        success: function (data) {
          try {
            var o = JSON.parse(data)
            if (o && typeof o.keepOn === 'boolean') page.keepOn = o.keepOn
          } catch (e) {}
          page.applyScreen()
        }
      })
    } catch (e) {}
  },

  onShow() {
    this.applyScreen()
    this.render()
  },

  onHide() {
    this.save()
    this.setScreen(false)
  },

  onDestroy() {
    this.save()
    this.setScreen(false)
  },

  // The system treats a right swipe as "back". While the score view is up,
  // a right swipe is a point, so it must not close the app; Salir in the
  // menu exits instead.
  onBackPress() {
    if (this.menu) this.menu = false
    return true
  },

  // --- gestures -----------------------------------------------------------

  start(evt) {
    var p = pointOf(evt, 'touches') || pointOf(evt, 'changedTouches')
    if (!p) return
    touch = { x: p.clientX, y: p.clientY, lastX: p.clientX, lastY: p.clientY, t: Date.now() }
  },

  move(evt) {
    var p = pointOf(evt, 'touches') || pointOf(evt, 'changedTouches')
    if (!p || !touch) return
    touch.lastX = p.clientX
    touch.lastY = p.clientY
  },

  end(evt, side) {
    if (!touch) return
    var p = pointOf(evt, 'changedTouches')
    var x = p ? p.clientX : touch.lastX
    var y = p ? p.clientY : touch.lastY
    var dx = x - touch.x
    var dy = y - touch.y
    var held = Date.now() - touch.t
    touch = null
    // Tap: point for that side.
    if (Math.abs(dx) <= TAP_SLOP && Math.abs(dy) <= TAP_SLOP && held <= TAP_MS) {
      this.add(side)
      return
    }
    // Horizontal swipe: right adds, left subtracts.
    if (Math.abs(dx) < MIN_DX || Math.abs(dx) < Math.abs(dy) * 1.5) return
    if (dx > 0) this.add(side)
    else this.remove(side)
  },

  // A cancelled touch (e.g. the system took the gesture) never scores.
  cancel() {
    touch = null
  },

  startThem(evt) { this.start(evt) },
  startUs(evt) { this.start(evt) },
  endThem(evt) { this.end(evt, THEM) },
  endUs(evt) { this.end(evt, US) },

  // --- scoring ------------------------------------------------------------

  add(side) {
    var next = addPoint(match, side)
    if (next === match) return
    match = next
    // A long buzz when the point closes a game, so it's felt without looking.
    var s = score(match)
    var closedGame = s.points.u === 0 && s.points.t === 0
    this.changed(side + '+', closedGame ? 'long' : 'short')
  },

  remove(side) {
    var next = removePoint(match, side)
    if (next === match) return
    match = next
    this.changed(side + '-', 'short')
  },

  changed(f, buzz) {
    // Saved on every change: the band can kill the app while the screen is off.
    this.save()
    this.buzz(buzz)
    this.showFlash(f)
  },

  buzz(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (e) {}
  },

  showFlash(f) {
    var page = this
    flash = f
    this.render()
    if (flashTimer) clearTimeout(flashTimer)
    flashTimer = setTimeout(function () {
      flash = ''
      flashTimer = null
      page.render()
    }, FLASH_MS)
  },

  // --- menu ---------------------------------------------------------------

  openMenu() {
    touch = null
    this.menu = true
  },

  closeMenu() {
    this.menu = false
  },

  resetMatch() {
    match = newMatch(match.golden)
    this.save()
    this.render()
    this.menu = false
  },

  toggleGolden() {
    match = setGolden(match, !match.golden)
    this.save()
    this.render()
  },

  toggleScreen() {
    this.keepOn = !this.keepOn
    this.applyScreen()
    try { storage.set({ key: PREFS_KEY, value: JSON.stringify({ keepOn: this.keepOn }) }) } catch (e) {}
  },

  exitApp() {
    this.save()
    this.setScreen(false)
    try { app.terminate() } catch (e) {}
  },

  // --- helpers ------------------------------------------------------------

  applyScreen() {
    this.setScreen(this.keepOn)
  },

  setScreen(on) {
    try { brightness.setKeepScreenOn({ keepScreenOn: on }) } catch (e) {}
  },

  save() {
    try { storage.set({ key: STORE_KEY, value: serialize(match) }) } catch (e) {}
  },

  render() {
    var s = score(match)
    var l = pointLabels(s, match.golden)
    var w = s.winner
    this.golden = match.golden

    // Points, labels and half tints.
    var adv = l.u === 'AD' ? US : (l.t === 'AD' ? THEM : null)
    var themPts = l.t, usPts = l.u
    var themCls = 'pts-them', usCls = 'pts-us'
    var themLabel = '', usLabel = ''
    var themHi = false, usHi = false
    if (w) {
      themPts = w === THEM ? 'WIN' : ''
      usPts = w === US ? 'WIN' : ''
      // WIN in the winner's own colour, like their points.
      themCls = 'pts-them'
      usCls = 'pts-us'
      themLabel = w === THEM ? 'GANAN' : ''
      usLabel = w === US ? 'GANAMOS' : ''
      themHi = w === THEM
      usHi = w === US
    } else if (adv === US) {
      usCls = 'pts-us'
      themCls = 'pts-them-dim'
      usLabel = 'VENTAJA'
      usHi = true
    } else if (adv === THEM) {
      themCls = 'pts-them'
      usCls = 'pts-us-dim'
      themLabel = 'VENTAJA'
      themHi = true
    }
    this.themPts = themPts
    this.usPts = usPts
    this.themPtsCls = themCls
    this.usPtsCls = usCls
    this.themLabel = themLabel
    this.usLabel = usLabel
    // The loser's half shows a drawn bar, not a '-' glyph: a dash sits at the
    // font's mid-height, well below the centre of the digits.
    this.themLost = w === US
    this.usLost = w === THEM

    // A flash wins over the tint while it lasts.
    var fs = flash ? flash[0] : ''
    var fAdd = flash ? flash[1] === '+' : false
    this.themBg = fs === THEM ? (fAdd ? 'flash-them' : 'flash-sub') : (themHi ? 'half-them-hi' : '')
    this.usBg = fs === US ? (fAdd ? 'flash-us' : 'flash-sub') : (usHi ? 'half-us-hi' : '')

    // Scoreboard columns: finished sets, then the current one.
    var cols = []
    for (var i = 0; i < s.setScores.length; i++) {
      var su = s.setScores[i][0]
      var st = s.setScores[i][1]
      var tWon = st > su
      cols.push({
        t: String(st), u: String(su), cur: false,
        tCls: tWon ? 'num-them num-won' : 'num-them-dim',
        uCls: tWon ? 'num-us-dim' : 'num-us num-won',
        tBar: tWon ? 'bar-them' : '',
        uBar: tWon ? '' : 'bar-us'
      })
    }
    if (!w) {
      cols.push({
        t: String(s.games.t), u: String(s.games.u), cur: true,
        tCls: 'num-them', uCls: 'num-us', tBar: '', uBar: ''
      })
    }
    var on = [], cur = [], ct = [], cu = [], tc = [], uc = [], tb = [], ub = []
    for (var k = 0; k < 3; k++) {
      var c = cols[k]
      on.push(!!c)
      cur.push(c ? c.cur : false)
      ct.push(c ? c.t : '')
      cu.push(c ? c.u : '')
      tc.push(c ? c.tCls : '')
      uc.push(c ? c.uCls : '')
      tb.push(c ? c.tBar : '')
      ub.push(c ? c.uBar : '')
    }
    this.colOn = on
    this.colCur = cur
    this.colThem = ct
    this.colUs = cu
    this.colThemCls = tc
    this.colUsCls = uc
    this.colThemBar = tb
    this.colUsBar = ub

    // Status pill: only when something special is going on.
    var pill = ''
    if (!w && s.tiebreak) pill = 'TIE-BREAK'
    else if (!w && match.golden && s.points.u === 3 && s.points.t === 3) pill = 'PUNTO DE ORO'
    this.pill = pill
  }
}
</script>

<style>
/* Palette: black panel, orange for them, blue for us.
   them  #ff9f0a  dim #734804  set-dim #5c4520  tint #3a2405  flash #5c3a08
   us    #64d2ff  dim #2d5f73  set-dim #245066  tint #062b40  flash #0a4766
   Layout (px): half 200 | board 120 | half 200 = 520.
   Big points: one style for digits, AD and WIN (88 px bold; WIN is the
   widest text that fits the capsule's rounded ends). */
.page {
  width: 212px;
  height: 520px;
  flex-direction: column;
  background-color: #000000;
}
.score {
  width: 212px;
  height: 520px;
  flex-direction: column;
}

/* --- halves --- */
.half {
  width: 212px;
  height: 200px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}
.half-them-hi {
  background-color: #3a2405;
}
.half-us-hi {
  background-color: #062b40;
}
.flash-them {
  background-color: #5c3a08;
}
.flash-us {
  background-color: #0a4766;
}
.flash-sub {
  background-color: #262626;
}
.label {
  width: 212px;
  height: 18px;
  line-height: 18px;
  font-size: 13px;
  font-weight: bold;
  text-align: center;
  color: #000000;
}
.label-them {
  color: #ff9f0a;
}
.label-us {
  color: #64d2ff;
}
.points {
  width: 212px;
  height: 112px;
  line-height: 112px;
  font-size: 88px;
  font-weight: bold;
  text-align: center;
}
.pts-them {
  color: #ff9f0a;
}
.pts-us {
  color: #64d2ff;
}
.pts-them-dim {
  color: #734804;
}
.pts-us-dim {
  color: #2d5f73;
}
/* Same box as .points, so the bar sits exactly where the digits' ink does. */
.lost {
  width: 212px;
  height: 112px;
  justify-content: center;
  align-items: center;
}
.lost-bar {
  width: 44px;
  height: 10px;
  border-radius: 5px;
  background-color: #444444;
}

/* --- scoreboard --- */
.board {
  width: 212px;
  height: 120px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  background-color: #141414;
}
.col {
  width: 58px;
  height: 104px;
  margin-left: 3px;
  margin-right: 3px;
  border-radius: 12px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.col-cur {
  background-color: #2e2e2e;
}
.num {
  width: 58px;
  height: 42px;
  line-height: 42px;
  font-size: 38px;
  text-align: center;
}
.num-them {
  color: #ff9f0a;
}
.num-us {
  color: #64d2ff;
}
.num-them-dim {
  color: #5c4520;
}
.num-us-dim {
  color: #245066;
}
.num-won {
  font-weight: bold;
}
.bar-slot {
  width: 58px;
  height: 5px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.bar {
  width: 20px;
  height: 3px;
  border-radius: 1px;
}
.bar-them {
  background-color: #ff9f0a;
}
.bar-us {
  background-color: #64d2ff;
}

/* --- status pill, centred on y = 320 (board / our half) --- */
.pill-wrap {
  position: absolute;
  left: 0px;
  top: 310px;
  width: 212px;
  height: 20px;
  flex-direction: row;
  justify-content: center;
}
.pill {
  height: 20px;
  padding-left: 10px;
  padding-right: 10px;
  border-radius: 10px;
  background-color: #ffffff;
  justify-content: center;
  align-items: center;
}
.pill-text {
  height: 20px;
  line-height: 20px;
  font-size: 12px;
  font-weight: bold;
  color: #000000;
  text-align: center;
}

/* --- menu --- */
.menu {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.menu-title {
  height: 26px;
  line-height: 26px;
  font-size: 20px;
  color: #ffffff;
  margin-bottom: 14px;
}
.btn {
  width: 184px;
  height: 58px;
  margin-top: 8px;
  border-radius: 16px;
  justify-content: center;
  align-items: center;
  background-color: #262626;
}
.btn-danger {
  background-color: #4a1a16;
}
.btn-primary {
  background-color: #ff9f0a;
}
.btn-label {
  font-size: 17px;
  color: #ffffff;
  text-align: center;
}
.btn-label-dark {
  color: #000000;
}
</style>
