/* --- handle --- */
/* A 36px strip at the bottom edge with a short bar, like the band's
   notification shade (Wear has none: round screens close by swiping
   right). Transparent: the list keeps peeking behind it. */
.grab {
  position: absolute;
  left: 0px;
  top: 480px;
  width: 212px;
  height: 40px;
  justify-content: center;
  align-items: center;
}
.grab-bar {
  width: 40px;
  height: 5px;
  border-radius: 3px;
  background-color: #8e8e93;
}

/* --- scroll indicator --- */
/* Wear's: 50x5dp track (75x6px here), onBackground at 20% luminance, 2dp
   from the edge (inside the capsule's 8px side margin); thumb at 80%
   luminance, half the track. */
.sbar {
  position: absolute;
  left: 196px;
  top: 222px;
  width: 6px;
  height: 75px;
  border-radius: 3px;
  flex-direction: column;
  background-color: #333333;
}
